{
    "proxmox": {
        "host": "your-proxmox-host-ip",
        "port": 8006,
        "verify_ssl": true,
        "service": "PVE",
        "timeout": 30
    },
    "auth": {
        "user": "monitor@pve",
        "token_name": "your-token-name",
        "token_value": "your-token-value"
    },
    "http": {
        "api_key_digests": []
    },
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
        "file": "proxmox_mcp.log"
    }
}
