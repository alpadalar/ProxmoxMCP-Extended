{
  "mcpServers": {
    "proxmox-mcp": {
      "command": "uv",
      "args": [
        "--directory",
        "/ABSOLUTE/PATH/TO/ProxmoxMCP-Extended",
        "run",
        "proxmox-mcp"
      ],
      "env": {
        "PROXMOX_MCP_CONFIG": "/ABSOLUTE/PATH/TO/ProxmoxMCP-Extended/proxmox-config/config.json"
      }
    },
    "proxmox-mcp-http": {
      "url": "http://127.0.0.1:8812/proxmox-mcp",
      "headers": {
        "Authorization": "Bearer YOUR_API_KEY"
      }
    }
  }
}
